DATABASE_URL="file:./dev.db"

# AI handwriting reading (Phase 3). Leave OPENAI_API_KEY empty to keep AI off;
# teachers can still type page text by hand.
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="gpt-6-luna"
# Safety cap: pages sent to the AI per day across the whole app.
AI_DAILY_PAGE_LIMIT="300"

# Study material and written-answer marking (flashcards, quiz questions, checking students' answers).
# Uses the same OPENAI_API_KEY. Leave the model empty to reuse OPENAI_TRANSCRIBE_MODEL.
OPENAI_STUDY_MODEL=""
# Safety caps per day across the whole app: notes turned into study material, and quiz submissions marked.
AI_DAILY_STUDY_LIMIT="200"
AI_DAILY_GRADE_LIMIT="2000"
